# Copy to .env and adjust. In Docker, compose.yaml sets these instead,
# with service names as hostnames (http://ollama:11434, http://qdrant:6333).

# Chat model
LLM_PROVIDER    = ollama
LLM_MODEL       = mistral
LLM_TEMPERATURE = 0.2
LLM_MAX_TOKENS  = 512

# Ollama (chat + embeddings)
OLLAMA_BASE_URL      = http://localhost:11434
EMBEDDING_MODEL      = qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS = 1024

# Qdrant
QDRANT_URL        = http://localhost:6333
QDRANT_COLLECTION = books

# Data (relative paths are resolved against the project root)
BOOKS_CSV_PATH = data/raw/books.csv
SQLITE_PATH    = data/sqlite/bookworm.db
